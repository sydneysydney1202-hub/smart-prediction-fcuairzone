# 前端配置
REACT_APP_API_URL=http://localhost:5000
REACT_APP_MAP_TOKEN=your_mapbox_token_here

# 後端配置
PORT=5000
NODE_ENV=development

# 數據庫
DATABASE_URL=postgresql://admin:password@localhost:5432/smart_prediction
REDIS_URL=redis://localhost:6379

# 天氣 API
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_LAT=24.1801
OPENWEATHER_LON=120.6484

# IP 定位服務
IP_LOCATION_API_KEY=your_ip_api_key_here

# JWT
JWT_SECRET=your_jwt_secret_key_here

# 預測模型
PREDICTION_CACHE_TTL=600
HISTORICAL_DATA_RETENTION_DAYS=90